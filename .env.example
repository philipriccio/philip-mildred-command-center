# Server Configuration
PORT=3001
NODE_ENV=development
DATA_DIR=server
UPLOAD_DIR=uploads
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:3000

# Online deployment auth
# Set COMMAND_CENTER_REQUIRE_AUTH=1 in production.
# Option A: use a server-side bearer token for API/WS smoke tests. Store the raw token in macOS Keychain / deployment secrets, not in git.
COMMAND_CENTER_AUTH_TOKEN=
# Option B: trust a verified reverse-proxy auth header (Cloudflare Access / Authentik / similar). Comma-separated allowlist.
COMMAND_CENTER_AUTH_EMAILS=
COMMAND_CENTER_REQUIRE_AUTH=
# Keep disabled for first public/read-mostly deployment unless Philip explicitly approves write controls.
COMMAND_CENTER_ENABLE_HIGH_RISK_ACTIONS=

# GitHub Integration (optional)
# Create a Personal Access Token at https://github.com/settings/tokens
# Required scope: repo
GITHUB_TOKEN=

# OpenClaw Gateway (optional)
GATEWAY_WS_URL=ws://localhost:18789
GATEWAY_TOKEN=
