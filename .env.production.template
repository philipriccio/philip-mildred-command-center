# Mission Control production template — do not put real secrets in this file.
# Copy values into Coolify/deployment secret UI, not into git.

PORT=3001
NODE_ENV=production

# Persistent volume paths. Mount durable storage at /data.
DATA_DIR=/data
UPLOAD_DIR=/data/uploads

# Public origin. Set only after Philip approves DNS/public deploy.
FRONTEND_ORIGINS=https://mission.companytheatre.ca

# Auth is mandatory for any online deployment.
COMMAND_CENTER_REQUIRE_AUTH=1

# Cloudflare Access / trusted proxy allowlist.
# Comma-separated lowercase emails. Example only; fill in deployment secrets/config.
COMMAND_CENTER_AUTH_EMAILS=

# Optional API/WS smoke-test bearer token.
# Store in Keychain or deployment secrets. Never commit the real value.
COMMAND_CENTER_AUTH_TOKEN=

# First online shape is read-mostly. Keep high-risk controls disabled.
COMMAND_CENTER_ENABLE_HIGH_RISK_ACTIONS=0

# Optional integrations. Leave blank unless deliberately enabling and smoke-testing.
GITHUB_TOKEN=
GATEWAY_WS_URL=ws://host.docker.internal:18789
GATEWAY_TOKEN=
